# 本地密钥模板：复制为 .env 后填写真实值。
#   cp server/configs/.env.example server/configs/.env
#
# 约定：
#   - .env 权限 600、已被 .gitignore 排除，真实密钥不进仓库；
#   - 未填写的项在 dev 下会走本地模拟实现（mock 短信 / mock 支付 / mock 进房凭据），
#     生产环境启动前由 scripts/secrets.sh check 硬拦；
#   - 腾讯云相关密钥（IM / TRTC / COS / SMS / TMS）全部在腾讯云控制台获取，
#     其中 IM 与 TRTC 共用同一套 SDKAppID 与密钥（UserSig 算法一致）。

# ---- 基础设施 ----
MYSQL_HOST=127.0.0.1
MYSQL_USER=datechat
MYSQL_PASSWORD=datechat_pass
MYSQL_DATABASE=datechat
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# ---- 应用安全（生产必须换成随机值）----
JWT_SECRET=
SECURITY_DATA_KEY=
SECURITY_HMAC_KEY=
METRICS_TOKEN=

# ---- 后台运营台初始账号 ----
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=

# ---- 腾讯云 IM（即时通信）----
TENCENT_IM_SDK_APP_ID=
TENCENT_IM_SECRET_KEY=
TENCENT_IM_CALLBACK_TOKEN=

# ---- 腾讯云 TRTC（音视频；未配置时与 IM 共用凭据）----
TENCENT_TRTC_SDK_APP_ID=
TENCENT_TRTC_SECRET_KEY=

# ---- 腾讯云 COS（对象存储，头像/图片）----
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_REGION=
TENCENT_COS_BUCKET=
TENCENT_COS_CDN_DOMAIN=

# ---- 腾讯云 SMS（短信验证码；留空则走 mock，验证码直接返回给客户端）----
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# ---- 腾讯云 TMS（文本内容安全；留空则走本地敏感词库）----
TENCENT_TMS_SECRET_ID=
TENCENT_TMS_SECRET_KEY=
TENCENT_TMS_BIZ_TYPE=

# ---- 实名认证（慧眼人脸核身）----
TENCENT_FACEID_SECRET_ID=
TENCENT_FACEID_SECRET_KEY=
TENCENT_FACEID_RULE_ID=
REALNAME_REDIRECT_URL=

# ---- 微信支付 ----
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_NOTIFY_URL=
